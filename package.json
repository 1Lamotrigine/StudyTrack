{
  "name": "studytrack-nextjs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:backup": "node --import tsx scripts/backup.ts",
    "db:restore": "node --import tsx scripts/restore.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "format": "prettier --write app components features lib scripts tests *.ts *.json",
    "format:check": "prettier --check app components features lib scripts tests *.ts *.json",
    "test:flows": "node scripts/flows.mjs",
    "test:dbms": "node scripts/dbms-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@electric-sql/pglite": "0.5.16",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.10.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
